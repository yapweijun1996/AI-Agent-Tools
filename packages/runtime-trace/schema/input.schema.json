{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "profile": {
      "const": "ui-regression-v1"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
    },
    "maxEvidenceAgeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "producer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
          },
          "required": {
            "type": "array",
            "items": {
              "enum": [
                "overflow",
                "overlap",
                "focus",
                "back"
              ]
            },
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": true
          },
          "tolerancePx": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 100000
              },
              "height": {
                "type": "number",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "document": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scrollWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "scrollWidth"
            ]
          },
          "rectangles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "x": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "visible": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "width",
                "height",
                "visible"
              ]
            },
            "maxItems": 128,
            "minItems": 0
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "first": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "second": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "allowOverlap": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "first",
                "second",
                "allowOverlap"
              ]
            },
            "maxItems": 128,
            "minItems": 0
          },
          "focus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expected": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "maxItems": 128,
                "minItems": 1
              },
              "observed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "maxItems": 128,
                "minItems": 0
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "expected"
            ]
          },
          "back": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expectedRouteId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "observedRouteId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "outcome": {
                "enum": [
                  "settled",
                  "timeout",
                  "unknown"
                ]
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "expectedRouteId"
            ]
          }
        },
        "required": [
          "id",
          "producer",
          "observedAt",
          "required",
          "viewport"
        ]
      },
      "maxItems": 32,
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "asOf",
    "maxEvidenceAgeSeconds",
    "cases"
  ]
}
