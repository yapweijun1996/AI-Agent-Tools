{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yapweijun1996/AI-Agent-Tool-Test-Scope/schemas/request.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "root"],
      "properties": {
        "operation": { "const": "capabilities" },
        "root": { "type": "string", "minLength": 1 }
      }
    },
    {
      "$ref": "#/$defs/discoveryRequest"
    },
    {
      "$ref": "#/$defs/planRequest"
    },
    {
      "$ref": "#/$defs/explainRequest"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "external": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": { "schemaVersion": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "enum": ["added", "modified", "deleted", "renamed", "unsupported"] },
              "oldPath": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "discoveryRequest": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation"],
          "properties": {
            "operation": { "const": "discover" },
            "root": { "type": "string", "minLength": 1 },
            "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        }
      ]
    },
    "planRequest": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "changed"],
          "properties": {
            "operation": { "const": "plan" },
            "root": { "type": "string", "minLength": 1 },
            "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "changed": { "$ref": "#/$defs/changed" },
            "projectProfile": { "$ref": "#/$defs/external" },
            "symbolEvidence": { "$ref": "#/$defs/external" },
            "impactEvidence": { "$ref": "#/$defs/external" }
          }
        }
      ]
    },
    "explainRequest": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "changed", "target"],
          "properties": {
            "operation": { "const": "explain" },
            "root": { "type": "string", "minLength": 1 },
            "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "changed": { "$ref": "#/$defs/changed" },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 }
              }
            },
            "projectProfile": { "$ref": "#/$defs/external" },
            "symbolEvidence": { "$ref": "#/$defs/external" },
            "impactEvidence": { "$ref": "#/$defs/external" }
          }
        }
      ]
    }
  }
}
