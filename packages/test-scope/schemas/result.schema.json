{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yapweijun1996/AI-Agent-Tool-Test-Scope/schemas/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "data", "diagnostics", "truncation", "stats"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "status": { "enum": ["complete", "partial", "error"] },
    "data": { "type": "object" },
    "diagnostics": { "type": "array" },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "reasons"],
      "properties": { "truncated": { "type": "boolean" }, "reasons": { "type": "array", "items": { "type": "string" } } }
    },
    "stats": { "type": "object" }
  }
}
