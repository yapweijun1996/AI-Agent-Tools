    "test:prepared": "python scripts/validate-contracts.py && node scripts/test.mjs",
    "smoke:pack": "node scripts/pack-check.mjs",
    "verify": "node scripts/verify.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "dependencies": { "ajv": "8.20.0" },
  "devDependencies": { "typescript": "5.8.2", "@types/node": "22.20.1" }
