{
  "name": "agent-native-git",
  "version": "0.0.0",
  "private": true,
  "description": "Windows-first local task coordination CLI with controlled foreground execution.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": "24.21.0" },
  "os": ["win32"],
  "cpu": ["x64"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapweijun1996/AI-Agent-Tools.git",
    "directory": "packages/agent-native-git"
  },
  "bugs": { "url": "https://github.com/yapweijun1996/AI-Agent-Tools/issues" },
  "homepage": "https://github.com/yapweijun1996/AI-Agent-Tools/tree/main/packages/agent-native-git#readme",
  "bin": { "angit": "bin/angit.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["bin", "dist", "assets", "native/Platform.cs", "native/Execution.cs", "schemas", "sql", "contracts", "docs/CONTRACT.md", "docs/CLI_REFERENCE.md", "docs/STAGE1.md", "docs/STAGE2.md", "docs/WINDOWS_METADATA_BACKEND.md", "README.md", "LICENSE"],
