{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/task-input.schema.json",
  "title": "Task specification accepted by task add",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-task-input/v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "runtimeProfileId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      },
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true
    },
    "scopePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 20
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "baseEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contractRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
          },
          "commitOid": {
            "type": "string",
            "minLength": 40,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "commitOid",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "instructions",
    "runtimeProfileId",
    "dependsOn",
    "scopePaths",
    "requiredChecks",
    "acceptance",
    "priority",
    "baseEpoch",
    "contractRefs"
  ],
  "additionalProperties": false
}
