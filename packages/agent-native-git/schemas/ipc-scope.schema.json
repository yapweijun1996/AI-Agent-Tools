{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/ipc-scope.schema.json",
  "type": "object",
  "properties": {
    "scopeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "handleDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinatorEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "principalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "allowedMethods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "allowedResources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revoked": {
      "type": "boolean"
    },
    "ownerApprovalReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "channelKind": {
      "enum": [
        "owner_control",
        "supervisor_report"
      ]
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "launchIdentity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "scopeId",
    "handleDigest",
    "projectId",
    "authorityIncarnation",
    "coordinatorEpoch",
    "principalId",
    "allowedMethods",
    "allowedResources",
    "expiresAtMs",
    "revoked",
    "ownerApprovalReference",
    "channelKind",
    "attemptId",
    "launchIdentity"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "channelKind": {
            "const": "supervisor_report"
          }
        }
      },
      "then": {
        "properties": {
          "attemptId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$",
            "maxLength": 64
          },
          "launchIdentity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "allowedMethods": {
            "type": "array",
            "items": {
              "enum": [
                "report_process",
                "append_message"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "attemptId": {
            "type": "null"
          },
          "launchIdentity": {
            "type": "null"
          }
        }
      }
    }
  ]
}
