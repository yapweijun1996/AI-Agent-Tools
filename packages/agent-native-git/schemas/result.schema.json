{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/result.schema.json",
  "title": "Stable CLI result envelope; queries may complete with negative verdicts",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-result/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "command": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "accepted",
        "completed",
        "invalid_input",
        "incomplete",
        "denied",
        "unavailable",
        "failed"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 30
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[A-Z][A-Z0-9_]+$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "retryable": {
              "type": "boolean"
            },
            "operationId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "operationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coordinatorEpoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "durationMs",
        "coordinatorEpoch",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "ok",
    "status",
    "data",
    "warnings",
    "error",
    "meta"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "completed"
            ]
          },
          "error": {
            "const": null
          },
          "data": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "enum": [
              "invalid_input",
              "incomplete",
              "denied",
              "unavailable",
              "failed"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80,
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "retryable": {
                "type": "boolean"
              },
              "operationId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "operationId"
            ],
            "additionalProperties": false
          },
          "data": {
            "const": null
          }
        }
      }
    }
  ]
}
