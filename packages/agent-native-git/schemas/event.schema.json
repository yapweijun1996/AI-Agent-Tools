{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/event.schema.json",
  "title": "Bounded NDJSON event; event IDs are cursors, not timestamps",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-event/v1"
    },
    "eventId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_.]+$"
    },
    "entityId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "coordinatorEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2000
    },
    "payload": {
      "type": "object",
      "maxProperties": 30
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "type",
    "entityId",
    "coordinatorEpoch",
    "createdAtMs",
    "summary",
    "payload",
    "authorityIncarnation"
  ],
  "additionalProperties": false
}
