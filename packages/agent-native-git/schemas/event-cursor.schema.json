{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/event-cursor.schema.json",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "historyIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "afterEventId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshotHighWatermark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "projectId",
    "authorityIncarnation",
    "historyIdentity",
    "afterEventId",
    "snapshotHighWatermark"
  ],
  "additionalProperties": false
}
