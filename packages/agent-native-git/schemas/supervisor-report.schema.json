{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/supervisor-report.schema.json",
  "type": "object",
  "properties": {
    "authority": {
      "$ref": "authority.schema.json"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "launchIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reportId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "reportKind": {
      "enum": [
        "started",
        "heartbeat",
        "terminated",
        "identity_unknown"
      ]
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "process": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "supervisorId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,63}$",
              "maxLength": 64
            },
            "launchIdentity": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "startIdentity": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "executableHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "descendantScopeHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "supervisorId",
            "launchIdentity",
            "pid",
            "startIdentity",
            "executableHash",
            "descendantScopeHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "writerTreeTerminated": {
      "type": "boolean"
    },
    "terminationReceiptHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "authority",
    "attemptId",
    "launchIdentity",
    "reportId",
    "reportKind",
    "observedAtMs",
    "process",
    "writerTreeTerminated",
    "terminationReceiptHash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reportKind": {
            "const": "terminated"
          }
        }
      },
      "then": {
        "properties": {
          "process": {
            "type": "object",
            "properties": {
              "supervisorId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{1,63}$",
                "maxLength": 64
              },
              "launchIdentity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "pid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "startIdentity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "executableHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "descendantScopeHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "supervisorId",
              "launchIdentity",
              "pid",
              "startIdentity",
              "executableHash",
              "descendantScopeHash"
            ],
            "additionalProperties": false
          },
          "writerTreeTerminated": {
            "const": true
          },
          "terminationReceiptHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "writerTreeTerminated": {
            "const": false
          },
          "terminationReceiptHash": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reportKind": {
            "const": "started"
          }
        }
      },
      "then": {
        "properties": {
          "process": {
            "type": "object",
            "properties": {
              "supervisorId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{1,63}$",
                "maxLength": 64
              },
              "launchIdentity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "pid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "startIdentity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "executableHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "descendantScopeHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "supervisorId",
              "launchIdentity",
              "pid",
              "startIdentity",
              "executableHash",
              "descendantScopeHash"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
