            "canonicalRepositoryPath",
            "canonicalCommonDir",
            "repositoryIdentity",
            "registrationId",
            "approvedBaseOid",
            "approvedBaseTreeOid",
            "objectFormat",
            "baselineRef",
            "integrationRef",
            "baselineExpectedAbsent",
            "integrationExpectedAbsent",
            "stateSchemaHash",
            "policyHash",
            "profilesHash"
