            "integrationExpectedAbsent": {
              "const": true
            },
            "stateSchemaHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policyHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profilesHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
