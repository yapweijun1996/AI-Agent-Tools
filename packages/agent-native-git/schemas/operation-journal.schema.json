                  "branchExpectedAbsent": {
                    "const": true
                  }
                }
              },
              "else": {
                "properties": {
                  "attemptId": {
                    "type": "null"
                  },
                  "operationOwnerId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{1,63}$",
                    "maxLength": 64
                  },
                  "branchRef": {
                    "type": "null"
                  },
                  "branchExpectedAbsent": {
                    "type": "null"
                  }
                }
              }
            }
          ]
