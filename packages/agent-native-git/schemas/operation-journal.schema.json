{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/operation-journal.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-operation/v1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "repositoryIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "init",
        "worktree_create",
        "spawn",
        "stop",
        "merge",
        "undo",
        "restore",
        "backup"
      ]
    },
    "originAuthority": {
      "$ref": "authority.schema.json"
    },
    "principalScopeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "requestKeyHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticRequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profilesHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "intentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent": {},
    "phase": {},
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastObservationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "repositoryIdentity",
    "operationId",
    "kind",
    "originAuthority",
    "principalScopeId",
    "requestKeyHash",
    "semanticRequestHash",
    "policyHash",
    "profilesHash",
    "createdAtMs",
    "intentHash",
    "intent",
    "phase",
    "version",
    "lastObservationId",
    "updatedAtMs"
