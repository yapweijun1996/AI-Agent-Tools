          "properties": {
            "canonicalRepositoryPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "canonicalCommonDir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "repositoryIdentity": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "registrationId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,63}$",
              "maxLength": 64
            },
            "approvedBaseOid": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "approvedBaseTreeOid": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
