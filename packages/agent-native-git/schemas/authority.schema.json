{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/authority.schema.json",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinatorEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "fencingToken": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    }
  },
  "required": [
    "projectId",
    "authorityIncarnation",
    "coordinatorEpoch",
    "resourceKey",
    "fencingToken",
    "ownerId"
  ],
  "additionalProperties": false
}
