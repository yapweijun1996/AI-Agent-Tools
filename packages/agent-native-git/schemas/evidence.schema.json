{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/evidence.schema.json",
  "title": "Evidence format; semantic verifier must bind source, process, policy and completeness",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-evidence/v1"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "planId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "candidateOid": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "treeOid": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "dirtyBefore": {
      "const": false
    },
    "dirtyAfter": {
      "type": "boolean"
    },
    "policyHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "profilesHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "nodeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "gitVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sqliteVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "dependencyDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "os",
        "arch",
        "nodeVersion",
        "gitVersion",
        "sqliteVersion",
        "dependencyDigest"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "kind": {
          "const": "coordinator-supervised-worker"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "runId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "incomplete"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "passed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skipped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "todo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runtimeProfileHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "startedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_-]{1,63}$"
                },
                "relativePath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1073741824
                }
              },
              "required": [
                "artifactId",
                "relativePath",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "checkId",
          "runId",
          "status",
          "exitCode",
          "signal",
          "completed",
          "passed",
          "failed",
          "skipped",
          "todo",
          "cancelled",
          "runtimeProfileHash",
          "startedAtMs",
          "endedAtMs",
          "artifacts"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "completed": {
                  "const": true
                },
                "exitCode": {
                  "const": 0
                },
                "signal": {
                  "type": "null"
                },
                "failed": {
                  "const": 0
                },
                "skipped": {
                  "const": 0
                },
                "todo": {
                  "const": 0
                },
                "cancelled": {
                  "const": 0
                },
                "passed": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 30
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "environmentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "evidenceId",
    "projectId",
    "planId",
    "candidateOid",
    "treeOid",
    "dirtyBefore",
    "dirtyAfter",
    "policyHash",
    "profilesHash",
    "environment",
    "producer",
    "checks",
    "verdict",
    "authorityIncarnation",
    "operationId",
    "environmentHash",
    "evidenceSha256"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "dirtyAfter": {
            "const": false
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          }
        }
      }
    }
  ]
}
