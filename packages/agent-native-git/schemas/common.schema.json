{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/common.schema.json",
  "title": "Shared primitives; identifiers are local schema identifiers, not endpoints",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "oid": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+$"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "taskStatus": {
      "enum": [
        "queued",
        "blocked",
        "leased",
        "running",
        "submitted",
        "validating",
        "integrating",
        "completed",
        "failed",
        "cancelled",
        "needs_review"
      ]
    },
    "attemptStatus": {
      "enum": [
        "reserved",
        "starting",
        "running",
        "stopping",
        "submitted",
        "failed",
        "cancelled",
        "orphaned"
      ]
    },
    "capability": {
      "enum": [
        "project.register",
        "project.read",
        "task.create",
        "task.message",
        "task.cancel",
        "attempt.start",
        "attempt.stop",
        "coordinator.start",
        "coordinator.stop",
        "integration.plan",
        "integration.apply",
        "snapshot.restore",
        "maintenance.backup"
      ]
    }
  }
}
