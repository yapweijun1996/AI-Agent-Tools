{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/backup-manifest.schema.json",
  "title": "Quiesced backup manifest; does not silently include dirty files or credentials",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-backup/v1"
    },
    "backupId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "contentEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventHighWatermark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "databaseSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "gitObjectFormat": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 5,
            "maxLength": 256
          },
          "oid": {
            "type": "string",
            "minLength": 40,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        },
        "required": [
          "name",
          "oid"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          }
        },
        "required": [
          "artifactId",
          "relativePath",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 10000
    },
    "dirtyWorktreesIncluded": {
      "const": false
    },
    "verifiedRestoreDrill": {
      "type": "boolean"
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "historyIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "backupId",
    "projectId",
    "contentEpoch",
    "eventHighWatermark",
    "databaseSchemaVersion",
    "gitObjectFormat",
    "refs",
    "files",
    "dirtyWorktreesIncluded",
    "verifiedRestoreDrill",
    "createdAtMs",
    "authorityIncarnation",
    "historyIdentity"
  ],
  "additionalProperties": false
}
