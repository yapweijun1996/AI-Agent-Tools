{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/task-create.schema.json",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    },
    "status": {
      "const": "queued"
    },
    "version": {
      "const": 0
    },
    "spec": {
      "$ref": "task-input.schema.json"
    }
  },
  "required": [
    "projectId",
    "taskId",
    "status",
    "version",
    "spec"
  ],
  "additionalProperties": false
}
