{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/commands/snapshot-restore.schema.json",
  "title": "18. angit snapshot restore request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "command": {
      "const": "snapshot restore"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "options": {
      "type": "object",
      "properties": {
        "targetSnapshotId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "dryRun": {
          "type": "boolean"
        },
        "apply": {
          "type": "boolean"
        },
        "planId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "targetSnapshotId"
          ],
          "properties": {
            "targetSnapshotId": true,
            "apply": {
              "const": false
            }
          },
          "not": {
            "properties": {"planId": true},
            "required": [
              "planId"
            ]
          }
        },
        {
          "required": [
            "apply",
            "planId"
          ],
          "properties": {
            "planId": true,
            "apply": {
              "const": true
            }
          },
          "not": {
            "anyOf": [
              {
                "properties": {"targetSnapshotId": true},
                "required": [
                  "targetSnapshotId"
                ]
              },
              {
                "properties": {"dryRun": true},
                "required": [
                  "dryRun"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "options",
    "projectId",
    "idempotencyKey"
  ],
  "additionalProperties": false
}
