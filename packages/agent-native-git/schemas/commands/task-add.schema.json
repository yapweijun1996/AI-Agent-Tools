{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/commands/task-add.schema.json",
  "title": "04. angit task add request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "command": {
      "const": "task add"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "options": {
      "type": "object",
      "properties": {
        "spec": {
          "$ref": "https://schemas.example.invalid/angit/v1/task-input.schema.json"
        }
      },
      "required": [
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "options",
    "projectId",
    "idempotencyKey"
  ],
  "additionalProperties": false
}
