{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/commands/init.schema.json",
  "title": "01. angit init request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "command": {
      "const": "init"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "options": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+$"
        },
        "approvedBase": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "policyFile": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+$"
        }
      },
      "required": [
        "repoPath",
        "approvedBase",
        "policyFile"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "options",
    "idempotencyKey"
  ],
  "additionalProperties": false
}
