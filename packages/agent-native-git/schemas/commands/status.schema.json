{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/commands/status.schema.json",
  "title": "03. angit status request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "command": {
      "const": "status"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "options": {
      "type": "object",
      "properties": {
        "follow": {
          "type": "boolean"
        },
        "format": {
          "enum": [
            "human",
            "json",
            "ndjson"
          ]
        },
        "cursor": {
          "$ref": "https://schemas.example.invalid/angit/v1/event-cursor.schema.json"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "follow": {
                "const": true
              }
            },
            "required": [
              "follow"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "ndjson"
              }
            },
            "required": [
              "format"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "options",
    "projectId"
  ],
  "additionalProperties": false
}
