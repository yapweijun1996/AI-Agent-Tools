{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/commands/integrate-plan.schema.json",
  "title": "15. angit integrate plan request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "command": {
      "const": "integrate plan"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "options": {
      "type": "object",
      "properties": {
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "undoOperationId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {"taskIds": true},
          "required": [
            "taskIds"
          ],
          "not": {
            "properties": {"undoOperationId": true},
            "required": [
              "undoOperationId"
            ]
          }
        },
        {
          "properties": {"undoOperationId": true},
          "required": [
            "undoOperationId"
          ],
          "not": {
            "properties": {"taskIds": true},
            "required": [
              "taskIds"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "options",
    "projectId",
    "idempotencyKey"
  ],
  "additionalProperties": false
}
