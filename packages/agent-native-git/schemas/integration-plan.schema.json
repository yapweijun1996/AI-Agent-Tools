{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/angit/v1/integration-plan.schema.json",
  "title": "Immutable plan: application rechecks all identities; ready does not mean tested",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "angit-plan/v1"
    },
    "planId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "kind": {
      "enum": [
        "merge",
        "undo",
        "restore"
      ]
    },
    "expectedOid": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "expectedContentEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "attemptId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "baseOid": {
            "type": "string",
            "minLength": 40,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "submissionOid": {
            "type": "string",
            "minLength": 40,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "patchSha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "taskId",
          "attemptId",
          "baseOid",
          "submissionOid",
          "patchSha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "candidateOid": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateTreeOid": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetSnapshotId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "undoOpId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policyHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "profilesHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "verdict": {
      "enum": [
        "ready",
        "conflicts",
        "blocked",
        "no_change"
      ]
    },
    "conflictPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$"
      },
      "minItems": 0,
      "maxItems": 200,
      "uniqueItems": true
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "planHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorityIncarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "originAuthority": {
      "$ref": "authority.schema.json"
    },
    "environmentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "maxLength": 64
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "projectId",
    "kind",
    "expectedOid",
    "expectedContentEpoch",
    "sources",
    "candidateOid",
    "candidateTreeOid",
    "targetSnapshotId",
    "undoOpId",
    "policyHash",
    "profilesHash",
    "requiredChecks",
    "verdict",
    "conflictPaths",
    "createdAtMs",
    "expiresAtMs",
    "planHash",
    "authorityIncarnation",
    "originAuthority",
    "environmentHash",
    "operationId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "candidateOid": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "candidateTreeOid": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "undo"
          }
        }
      },
      "then": {
        "properties": {
          "undoOpId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$",
            "maxLength": 64
          },
          "targetSnapshotId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "restore"
          }
        }
      },
      "then": {
        "properties": {
          "targetSnapshotId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$",
            "maxLength": 64
          },
          "undoOpId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "merge"
          }
        }
      },
      "then": {
        "properties": {
          "undoOpId": {
            "type": "null"
          },
          "targetSnapshotId": {
            "type": "null"
          },
          "sources": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
