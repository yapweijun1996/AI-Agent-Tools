    {
      "number": 8,
      "name": "task cancel",
      "slug": "task-cancel",
      "synopsis": "angit task cancel TASK_ID --reason TEXT [--wait-ms N]",
      "capability": "task.cancel",
      "effects": "managed-write",
      "purpose": "Cancel queued work or request stop of an active attempt.",
