      "options": {
        "taskId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "history": {
          "type": "boolean"
        },
        "cursor": {
          "$ref": "https://schemas.example.invalid/angit/v1/event-cursor.schema.json"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "requiredOptions": [
        "taskId"
      ]
    },
    {
