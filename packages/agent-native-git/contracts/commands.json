{
  "schemaVersion": "angit-command-catalog/v1",
  "commandCount": 18,
  "commands": [
    {
      "number": 1,
      "name": "init",
      "slug": "init",
      "synopsis": "angit init --repo PATH --base FULL_OID --policy-file PATH",
      "capability": "project.register",
      "effects": "managed-write",
      "purpose": "Register an existing repository without editing its main checkout.",
      "success": "projectId, repo identity, baseline OID, policy hash; baseline verification=unverified",
      "errors": [
        "REPOSITORY_UNSUPPORTED",
        "POLICY_NOT_APPROVED",
        "REPOSITORY_IDENTITY_CHANGED"
      ],
      "example": "angit init --repo C:/Disposable/demo --base aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa --policy-file C:/Disposable/owner-policy.json",
      "requestSchema": "schemas/commands/init.schema.json",
      "reference": "docs/CLI_REFERENCE.md#init",
      "options": {
        "repoPath": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+$"
        },
        "approvedBase": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "policyFile": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+$"
        }
      },
      "requiredOptions": [
        "repoPath",
        "approvedBase",
        "policyFile"
      ]
    },
    {
      "number": 2,
      "name": "doctor",
      "slug": "doctor",
      "synopsis": "angit doctor [--deep]",
      "capability": "project.read",
      "effects": "read",
      "purpose": "Inspect runtime capabilities, state integrity, identity, protected refs and stale operations.",
      "success": "verdict=healthy|attention|unsupported; diagnostics with evidence, no auto-repair",
      "errors": [
        "PROJECT_NOT_FOUND",
        "INCOMPLETE_EVIDENCE"
      ],
      "example": "angit doctor --repo C:/Disposable/demo --deep --json",
      "requestSchema": "schemas/commands/doctor.schema.json",
      "reference": "docs/CLI_REFERENCE.md#doctor",
      "options": {
        "deep": {
          "type": "boolean"
        }
      },
      "requiredOptions": []
    },
    {
      "number": 3,
      "name": "status",
      "slug": "status",
      "synopsis": "angit status [--follow --format ndjson] [--cursor-file CURSOR_JSON]",
      "capability": "project.read",
      "effects": "read",
      "purpose": "Read project/queue/attempt/operation status or a resumable event stream.",
      "success": "counts, integration OID, verification, content epoch; history-bound cursor and bounded replay, NDJSON events in follow mode",
      "errors": [
        "CURSOR_HISTORY_MISMATCH",
        "PROJECT_NOT_FOUND"
      ],
      "example": "angit status --repo C:/Disposable/demo --json",
      "requestSchema": "schemas/commands/status.schema.json",
      "reference": "docs/CLI_REFERENCE.md#status",
      "options": {
        "follow": {
          "type": "boolean"
        },
        "format": {
          "enum": [
            "human",
            "json",
            "ndjson"
          ]
        },
        "cursor": {
          "$ref": "https://schemas.example.invalid/angit/v1/event-cursor.schema.json"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "requiredOptions": []
    },
    {
      "number": 4,
      "name": "task add",
      "slug": "task-add",
      "synopsis": "angit task add --file TASK_JSON",
      "capability": "task.create",
      "effects": "metadata-write",
      "purpose": "Create one immutable task spec with dependencies, scope and checks.",
      "success": "taskId, initial version=0, status=queued; eligibility projection may transition to blocked/review",
      "errors": [
        "TASK_EXISTS",
        "DEPENDENCY_CYCLE",
        "CROSS_PROJECT_DEPENDENCY",
        "STALE_CONTENT_EPOCH"
      ],
      "example": "angit task add --repo C:/Disposable/demo --file examples/tasks/frontend.json",
      "requestSchema": "schemas/commands/task-add.schema.json",
      "reference": "docs/CLI_REFERENCE.md#task-add",
      "options": {
        "spec": {
          "$ref": "https://schemas.example.invalid/angit/v1/task-input.schema.json"
        }
      },
      "requiredOptions": [
        "spec"
      ]
    },
    {
      "number": 5,
      "name": "task list",
      "slug": "task-list",
      "synopsis": "angit task list [--status STATUS] [--limit N] [--after-task-id ID]",
      "capability": "project.read",
      "effects": "read",
      "purpose": "List bounded task summaries with stable ID pagination.",
      "success": "items, nextCursor; task completion history separate from current effectiveness",
      "errors": [
        "PROJECT_NOT_FOUND"
      ],
      "example": "angit task list --repo C:/Disposable/demo --status submitted --json",
      "requestSchema": "schemas/commands/task-list.schema.json",
      "reference": "docs/CLI_REFERENCE.md#task-list",
      "options": {
        "status": {
          "enum": [
            "queued",
            "blocked",
            "leased",
            "running",
            "submitted",
            "validating",
            "integrating",
            "completed",
            "failed",
            "cancelled",
            "needs_review"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "afterTaskId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        }
      },
      "requiredOptions": []
    },
    {
