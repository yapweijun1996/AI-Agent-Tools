          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "requiredOptions": [
        "taskId",
        "reason"
      ]
    },
    {
      "number": 9,
      "name": "agent start",
      "slug": "agent-start",
      "synopsis": "angit agent start --task ID --profile ID [--retry]",
      "capability": "attempt.start",
      "effects": "managed-write",
      "purpose": "Reserve a new attempt, provision an owned worktree and start one approved CLI.",
      "success": "attemptId/worktreeId/operationId; starting is not proof of running or completion",
      "errors": [
        "TASK_NOT_READY",
        "ATTEMPT_STILL_ACTIVE",
        "PROFILE_NOT_APPROVED",
        "SANDBOX_UNAVAILABLE"
