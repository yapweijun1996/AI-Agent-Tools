      "example": "angit agent start --repo C:/Disposable/demo --task tsk_frontend --profile codex_local",
      "requestSchema": "schemas/commands/agent-start.schema.json",
      "reference": "docs/CLI_REFERENCE.md#agent-start",
      "options": {
        "taskId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "runtimeProfileId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "retry": {
          "type": "boolean"
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "requiredOptions": [
