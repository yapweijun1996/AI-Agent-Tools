    {
      "number": 15,
      "name": "integrate plan",
      "slug": "integrate-plan",
      "synopsis": "angit integrate plan --tasks ID[,ID...] | --undo-integration OP_ID",
      "capability": "integration.plan",
      "effects": "planning-write",
      "purpose": "Freeze source OIDs and produce a candidate plan; no builds or tests.",
      "success": "planId/hash, expected OID/epoch, candidate OID, verdict and conflict paths",
      "errors": [
        "SOURCE_NOT_SUBMITTED",
        "UNSUPPORTED_DIFF",
        "STALE_CONTENT_EPOCH"
      ],
      "example": "angit integrate plan --repo C:/Disposable/demo --tasks tsk_frontend,tsk_backend --json",
      "requestSchema": "schemas/commands/integrate-plan.schema.json",
      "reference": "docs/CLI_REFERENCE.md#integrate-plan",
      "options": {
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "undoOperationId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        }
      },
      "requiredOptions": []
    },
