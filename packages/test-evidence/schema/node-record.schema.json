{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Evidence node-record",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "header"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "reporter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "node"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "version"
          ]
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "reporter",
        "runtime"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "summary"
        },
        "success": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "suites": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "todo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tests",
            "suites",
            "passed",
            "failed",
            "skipped",
            "todo",
            "cancelled"
          ]
        }
      },
      "required": [
        "type",
        "success",
        "counts"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "case"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "todo",
            "cancelled"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "status"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unsupported"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "end"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
