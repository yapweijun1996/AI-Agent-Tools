{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Evidence unified",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "suites": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "todo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tests",
            "suites",
            "passed",
            "failed",
            "skipped",
            "todo",
            "cancelled"
          ]
        }
      },
      "required": [
        "success",
        "counts"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "todo",
              "cancelled"
            ]
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "path",
              "line"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "maxItems": 20000
    }
  },
  "required": [
    "schemaVersion",
    "producer",
    "summary"
  ]
}
