{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Evidence result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "agent-test-evidence"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "incomplete",
        "error"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "summarize",
                "verify"
              ]
            },
            "verdict": {
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tests": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "suites": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "todo": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cancelled": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "tests",
                "suites",
                "passed",
                "failed",
                "skipped",
                "todo",
                "cancelled"
              ]
            },
            "countUnit": {
              "const": "test-executions"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "checkId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "runId": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "enum": [
                      "passed",
                      "failed",
                      "unknown",
                      "not_run"
                    ]
                  },
                  "applicable": {
                    "type": "boolean"
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "not_run",
                        "source_mismatch",
                        "environment_mismatch",
                        "process_unknown",
                        "unfinished",
                        "failed",
                        "zero_tests",
                        "skipped",
                        "todo",
                        "cancelled"
                      ]
                    },
                    "maxItems": 12
                  },
                  "counts": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "tests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "suites": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "passed": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "failed": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "skipped": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "todo": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "cancelled": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "tests",
                          "suites",
                          "passed",
                          "failed",
                          "skipped",
                          "todo",
                          "cancelled"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "evidence": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "artifactId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1024
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "pointer": {
                            "type": "string",
                            "pattern": "^/"
                          },
                          "line": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "artifactId",
                          "path",
                          "sha256"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "anomalies": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "caseId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                        },
                        "status": {
                          "enum": [
                            "passed",
                            "failed",
                            "skipped",
                            "todo",
                            "cancelled"
                          ]
                        },
                        "evidence": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "artifactId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            "pointer": {
                              "type": "string",
                              "pattern": "^/"
                            },
                            "line": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "artifactId",
                            "path",
                            "sha256"
                          ]
                        }
                      },
                      "required": [
                        "caseId",
                        "status",
                        "evidence"
                      ]
                    },
                    "maxItems": 500
                  }
                },
                "required": [
                  "checkId",
                  "runId",
                  "state",
                  "applicable",
                  "reasons",
                  "counts",
                  "evidence",
                  "anomalies"
                ]
              },
              "maxItems": 256
            }
          },
          "required": [
            "operation",
            "verdict",
            "counts",
            "countUnit",
            "checks"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "enum": [
                  "summarize",
                  "verify"
                ]
              },
              "maxItems": 2
            },
            "formats": {
              "type": "array",
              "items": {
                "enum": [
                  "unified-json",
                  "node-jsonl"
                ]
              },
              "maxItems": 2
            },
            "requestVersion": {
              "const": "1.0.0"
            },
            "processExecution": {
              "const": false
            },
            "sourceIdentity": {
              "const": "caller-declared"
            }
          },
          "required": [
            "operations",
            "formats",
            "requestVersion",
            "processExecution",
            "sourceIdentity"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "maxItems": 16
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "maxItems": 16
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_request_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_artifact_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_checks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_anomalies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "max_request_bytes",
            "max_artifact_bytes",
            "max_total_bytes",
            "max_checks",
            "max_runs",
            "max_records",
            "max_cases",
            "max_depth",
            "max_anomalies",
            "max_output_bytes"
          ]
        }
      },
      "required": [
        "scope",
        "limits"
      ]
    }
  },
  "required": [
    "schema_version",
    "tool",
    "status",
    "complete",
    "data",
    "errors",
    "warnings",
    "meta"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "data": {
            "type": "object"
          },
          "errors": {
            "maxItems": 0,
            "type": "array"
          }
        }
      },
      "else": {
        "properties": {
          "complete": {
            "const": false
          },
          "data": {
            "type": "null"
          },
          "errors": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
