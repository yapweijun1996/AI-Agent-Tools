{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Evidence request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "expectedSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "worktreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "commit",
        "dirty"
      ]
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "os": {
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              },
              "runtime": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
                "maxLength": 64
              }
            },
            "required": [
              "os",
              "runtime",
              "version"
            ]
          }
        },
        "required": [
          "id",
          "environment"
        ]
      },
      "maxItems": 256,
      "minItems": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "checkId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,64}$"
              },
              "dirty": {
                "type": "boolean"
              },
              "worktreeSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "commit",
              "dirty"
            ]
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "os": {
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              },
              "runtime": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
                "maxLength": 64
              }
            },
            "required": [
              "os",
              "runtime",
              "version"
            ]
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
                "maxLength": 64
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "exitCode": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "format": {
                "enum": [
                  "unified-json",
                  "node-jsonl"
                ]
              }
            },
            "required": [
              "id",
              "path",
              "format"
            ]
          }
        },
        "required": [
          "id",
          "checkId",
          "source",
          "environment",
          "producer",
          "exitCode",
          "signal",
          "completed",
          "artifact"
        ]
      },
      "maxItems": 256
    }
  },
  "required": [
    "schemaVersion",
    "expectedSource",
    "requiredChecks",
    "runs"
  ]
}
