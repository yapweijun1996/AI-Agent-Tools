{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "npm": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "python": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "codex": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "configuration": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write",
                "execute"
              ]
            }
          }
        }
      }
    }
  }
}
