{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "operation",
    "status",
    "complete",
    "data",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "tool": {
      "const": "agent-env-doctor"
    },
    "operation": {
      "enum": [
        "capabilities",
        "check"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "error"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "checks",
            "summary"
          ],
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "status",
                  "expected",
                  "observed",
                  "evidence",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "pass",
                      "fail",
                      "unknown"
                    ]
                  },
                  "expected": {},
                  "observed": {},
                  "reason": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "object",
                    "required": [
                      "source",
                      "pointer",
                      "observedSource",
                      "observedPointer"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "pointer": {
                        "type": "string"
                      },
                      "observedSource": {
                        "type": "string"
                      },
                      "observedPointer": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "summary": {
              "type": "object",
              "required": [
                "pass",
                "fail",
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "pass": {
                  "type": "integer",
                  "minimum": 0
                },
                "fail": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "operations",
            "limits"
          ],
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limits": {
              "type": "object"
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
