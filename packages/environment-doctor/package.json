{
  "name": "ai-agent-tool-environment-doctor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Read-only requirements versus sanitized runtime evidence.",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "bin": {
    "agent-env-doctor": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "schema",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck test/type-contract.ts",
    "test": "node --test test/*.test.js",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapweijun1996/AI-Agent-Tools.git",
    "directory": "packages/environment-doctor"
  },
  "bugs": {
    "url": "https://github.com/yapweijun1996/AI-Agent-Tools/issues"
  }
}
