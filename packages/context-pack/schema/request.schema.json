{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Context Pack manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "context-pack-v1"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id"
      ]
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+=-]{1,128}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "utf8-bytes"
        },
        "max": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      },
      "required": [
        "unit",
        "max"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\.json$"
          },
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:/@+=-]{1,128}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mandatory": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "locators": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                }
              },
              "required": [
                "path",
                "start_line",
                "end_line"
              ]
            }
          }
        },
        "required": [
          "id",
          "artifact",
          "tool",
          "snapshot"
        ]
      }
    }
  },
  "required": [
    "manifest_version",
    "profile",
    "task",
    "snapshot",
    "budget",
    "items"
  ]
}
